{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAP Functional Business Scenario Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "scenario_type",
    "domain",
    "modules",
    "sap_products",
    "releases",
    "deployment",
    "difficulty",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "scenario_type": {
      "type": "string",
      "enum": [
        "business_process",
        "enterprise_structure",
        "master_data",
        "configuration",
        "ai_use_case"
      ]
    },
    "domain": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "sap_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deployment": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "on-premise",
          "private-cloud",
          "public-cloud",
          "btp"
        ]
      },
      "minItems": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "reviewed",
        "deprecated"
      ]
    },
    "business_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
